# OpenRAG Cloud Deployment - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# LLM Configuration (Anthropic Claude)
# ============================================
# Get your API key from: https://console.anthropic.com/
BASE_URL=https://api.anthropic.com/v1
API_KEY=sk-ant-your-anthropic-api-key-here
MODEL=claude-sonnet-4-20250514

# VLM (Vision Language Model) - uses same Claude API for image understanding
VLM_BASE_URL=https://api.anthropic.com/v1
VLM_API_KEY=sk-ant-your-anthropic-api-key-here
VLM_MODEL=claude-sonnet-4-20250514

# ============================================
# Security Configuration
# ============================================
# Generate a secure token: openssl rand -hex 32
AUTH_TOKEN=sk-openrag-change-this-to-a-secure-token

# PostgreSQL credentials (change these!)
POSTGRES_USER=openrag
POSTGRES_PASSWORD=change-this-secure-password-here
POSTGRES_DB=openrag

# ============================================
# External Access
# ============================================
# Your domain or public IP (used for CORS and callbacks)
EXTERNAL_URL=https://your-domain.com
# Set to true since we're using AUTH_TOKEN
INCLUDE_CREDENTIALS=true

# ============================================
# Embedder Configuration
# ============================================
EMBEDDER_MODEL_NAME=jinaai/jina-embeddings-v3
EMBEDDER_BASE_URL=http://vllm:8000/v1
EMBEDDER_API_KEY=EMPTY
MAX_MODEL_LEN=8192

# ============================================
# Reranker Configuration
# ============================================
RERANKER_ENABLED=true
RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base

# ============================================
# Retriever Configuration
# ============================================
RETRIEVER_TOP_K=20
RETRIEVER_TYPE=single

# ============================================
# Document Processing
# ============================================
PDFLoader=MarkerLoader
IMAGE_CAPTIONING=true
SAVE_UPLOADED_FILES=true

# ============================================
# Chainlit UI
# ============================================
WITH_CHAINLIT_UI=true
CHAINLIT_PORT=8090

# ============================================
# Ray Configuration
# ============================================
RAY_DEDUP_LOGS=0
RAY_ENABLE_RECORD_ACTOR_TASK_LOGGING=1
RAY_task_retry_delay_ms=3000
RAY_ENABLE_UV_RUN_RUNTIME_ENV=0
RAY_NUM_GPUS=0.5

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# HuggingFace (Optional - for private models)
# ============================================
# HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# ============================================
# Prompts Directory
# ============================================
PROMPTS_DIR=../prompts/example1
