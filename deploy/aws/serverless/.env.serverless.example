# OpenRAG Serverless Architecture - Environment Configuration
# Uses managed services (Zilliz, Neon) + EC2 Spot on-demand

# ============================================
# LLM Configuration (Anthropic Claude)
# ============================================
BASE_URL=https://api.anthropic.com/v1
API_KEY=sk-ant-your-anthropic-api-key
MODEL=claude-sonnet-4-20250514

VLM_BASE_URL=https://api.anthropic.com/v1
VLM_API_KEY=sk-ant-your-anthropic-api-key
VLM_MODEL=claude-sonnet-4-20250514

# ============================================
# Zilliz Cloud (Managed Milvus) - FREE TIER
# Sign up at: https://cloud.zilliz.com/
# ============================================
VDB_HOST=your-cluster.api.gcp-us-west1.zillizcloud.com
VDB_PORT=443
VDB_CONNECTOR_NAME=milvus
ZILLIZ_API_KEY=your-zilliz-api-key
# Use secure connection for cloud
MILVUS_SECURE=true

# ============================================
# Neon (Managed PostgreSQL) - FREE TIER
# Sign up at: https://neon.tech/
# ============================================
POSTGRES_HOST=ep-xxx-xxx-123456.us-east-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=your-username
POSTGRES_PASSWORD=your-neon-password
POSTGRES_DB=openrag
# Neon requires SSL
POSTGRES_SSLMODE=require

# ============================================
# Security
# ============================================
AUTH_TOKEN=sk-openrag-generate-secure-token

# ============================================
# Embedder (runs on EC2 Spot)
# ============================================
EMBEDDER_MODEL_NAME=jinaai/jina-embeddings-v3
EMBEDDER_BASE_URL=http://localhost:8000/v1
EMBEDDER_API_KEY=EMPTY
MAX_MODEL_LEN=8192

# ============================================
# Reranker
# ============================================
RERANKER_ENABLED=true
RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base
RERANKER_BASE_URL=http://localhost:7997

# ============================================
# Features
# ============================================
WITH_CHAINLIT_UI=true
CHAINLIT_PORT=8090
IMAGE_CAPTIONING=true
SAVE_UPLOADED_FILES=true

# ============================================
# Auto-stop Configuration
# ============================================
# Stop EC2 after this many seconds of inactivity
AUTO_STOP_IDLE_SECONDS=900
# CloudWatch metric namespace for activity tracking
CLOUDWATCH_NAMESPACE=OpenRAG

# ============================================
# Cloudflare Tunnel (optional, for free HTTPS)
# ============================================
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# ============================================
# Ray
# ============================================
RAY_DEDUP_LOGS=0
RAY_ENABLE_RECORD_ACTOR_TASK_LOGGING=1
RAY_NUM_GPUS=0.5

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
