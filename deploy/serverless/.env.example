# LightRAG Serverless Deployment Configuration
# Copy to .env and fill in your values

# ============================================
# LLM Configuration (Anthropic Claude)
# ============================================
# Get your API key from: https://console.anthropic.com/
LLM_BINDING=anthropic
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514
# Alternative models:
# LLM_MODEL=claude-3-opus-20240229      # Highest quality
# LLM_MODEL=claude-3-5-sonnet-20241022  # Good balance

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# ============================================
# Embedding Configuration (Voyage AI)
# ============================================
# Get your API key from: https://www.voyageai.com/
# Free tier: 50M tokens/month
EMBEDDING_BINDING=voyage
VOYAGE_API_KEY=pa-your-voyage-api-key-here
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIM=1024
EMBEDDING_BATCH_NUM=32

# ============================================
# PostgreSQL (Neon - Free Tier)
# ============================================
# Sign up at: https://neon.tech/
# Free tier: 0.5GB storage, 1 project
POSTGRES_HOST=ep-your-endpoint.us-east-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=your-username
POSTGRES_PASSWORD=your-password
POSTGRES_DATABASE=lightrag
POSTGRES_SSL_MODE=require

# Storage backends (all use PostgreSQL)
KV_STORAGE=PGKVStorage
VECTOR_STORAGE=PGVectorStorage
GRAPH_STORAGE=PGGraphStorage
DOC_STATUS_STORAGE=PGDocStatusStorage

# Vector index configuration
POSTGRES_VECTOR_INDEX_METHOD=hnsw
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=64

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=9621
WORKERS=2

# WebUI
WEBUI_TITLE=LightRAG
WEBUI_DESCRIPTION=Personal Knowledge Base

# ============================================
# Security
# ============================================
# Generate: openssl rand -hex 32
LIGHTRAG_API_KEY=sk-lightrag-change-this-to-secure-token
TOKEN_SECRET=change-this-to-random-secret
TOKEN_EXPIRE_HOURS=48

# CORS (restrict in production)
CORS_ORIGINS=*

# ============================================
# File Handling
# ============================================
INPUT_DIR=/app/data/inputs
WORKING_DIR=/app/data/rag_storage
MAX_UPLOAD_SIZE=104857600

# ============================================
# Query & Retrieval
# ============================================
TOP_K=10
CHUNK_TOP_K=10
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
COSINE_THRESHOLD=0.2
ENABLE_LLM_CACHE=true

# ============================================
# Entity Extraction
# ============================================
ENTITY_TYPES=person,organization,location,event,product,concept
SUMMARY_LANGUAGE=english

# ============================================
# AWS Configuration (for Fargate deployment)
# ============================================
AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012

# ============================================
# Optional: Reranking (improves quality)
# ============================================
# RERANK_BINDING=jina
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# JINA_API_KEY=jina_xxx

# ============================================
# Optional: Observability
# ============================================
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
